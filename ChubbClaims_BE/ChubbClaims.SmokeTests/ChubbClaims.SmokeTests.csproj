<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end checks against a running stack (API, SQL Server, Kafka, SignalR): nothing is mocked.
    Black-box on purpose: no reference to the API's projects, so the tests see the same JSON a client does.
    When the API isn't reachable every test is skipped, so `dotnet test` on the solution still works without Docker.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="System.Net" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>

</Project>
