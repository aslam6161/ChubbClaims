# Copy to .env (not committed). SQL Server requires 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Chubb_Dev_Passw0rd!

# Optional: claim photos and documents in Cloudinary (stored as private assets). Leave blank to
# keep them in a Docker volume instead; attaching works either way. The secret never leaves the API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chubbclaims-dev
