{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "LogFormat": "Text",
  "Jwt": {
    "Issuer": "chubbclaims-dev",
    "Audience": "chubbclaims-web",
    "LifetimeMinutes": 480
  },
  "ClaimRules": {
    "SlaDaysToDecision": 10,
    "MaxIncidentAgeDays": 365,
    "Markets": {
      "MY": {
        "DefaultMotorReserve": 5000,
        "DefaultPropertyReserve": 20000,
        "HighPriorityThreshold": 50000
      },
      "SG": {
        "DefaultMotorReserve": 2000,
        "DefaultPropertyReserve": 8000,
        "HighPriorityThreshold": 20000
      },
      "HK": {
        "DefaultMotorReserve": 12000,
        "DefaultPropertyReserve": 50000,
        "HighPriorityThreshold": 120000
      },
      "TH": {
        "DefaultMotorReserve": 50000,
        "DefaultPropertyReserve": 200000,
        "HighPriorityThreshold": 500000
      },
      "ID": {
        "DefaultMotorReserve": 20000000,
        "DefaultPropertyReserve": 80000000,
        "HighPriorityThreshold": 200000000
      },
      "AU": {
        "DefaultMotorReserve": 2500,
        "DefaultPropertyReserve": 10000,
        "HighPriorityThreshold": 25000
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "AllowedHosts": "*"
}
